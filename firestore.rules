rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile & Garage
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow delete: if false;
    }

    // Multiplayer Race Rooms
    match /rooms/{roomId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(roomId) && request.resource.data.hostId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(roomId);
      allow delete: if isSignedIn() && resource.data.hostId == request.auth.uid;

      // Realtime Players in Room
      match /players/{playerId} {
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(playerId);
        allow delete: if isSignedIn() && (request.auth.uid == playerId || request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId);
      }
    }
  }
}
