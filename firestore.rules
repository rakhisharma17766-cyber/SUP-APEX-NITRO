rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Custom Racer Accounts (Register & Sign In)
    match /racer_accounts/{accountId} {
      allow get: if isValidId(accountId);
      allow create: if isValidId(accountId) && request.resource.data.username == accountId;
      allow update: if isValidId(accountId);
      allow delete: if false;
    }

    // User Profile & Garage Data (Custom Authentication Persistence)
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow create, update: if isValidId(userId);
      allow delete: if false;
    }

    // Multiplayer Race Rooms
    match /rooms/{roomId} {
      allow get, list: if isValidId(roomId);
      allow create: if isValidId(roomId);
      allow update: if isValidId(roomId);
      allow delete: if isValidId(roomId);

      // Realtime Players in Room
      match /players/{playerId} {
        allow get, list: if isValidId(playerId);
        allow create, update: if isValidId(playerId);
        allow delete: if isValidId(playerId);
      }
    }
  }
}
